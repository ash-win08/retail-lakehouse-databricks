{
  "datasets": [
    {
      "name": "fdb786de",
      "displayName": "kpis",
      "queryLines": [
        "SELECT COUNT(DISTINCT order_id) AS orders,\r\n",
        "       ROUND(SUM(price), 2) AS revenue,\r\n",
        "       ROUND(SUM(price) / COUNT(DISTINCT order_id), 2) AS avg_order_value,\r\n",
        "       ROUND(100 * SUM(CASE WHEN is_late_delivery THEN 1 ELSE 0 END)\r\n",
        "             / NULLIF(SUM(CASE WHEN is_late_delivery IS NOT NULL THEN 1 ELSE 0 END), 0), 1) AS late_delivery_pct\r\n",
        "FROM workspace.gold.fact_sales\r\n",
        "WHERE order_found AND order_status NOT IN ('canceled', 'unavailable');"
      ]
    },
    {
      "name": "a6995f46",
      "displayName": "daily_revenue",
      "queryLines": [
        "SELECT order_date, revenue, orders\r\n",
        "FROM workspace.gold.agg_daily_revenue\r\n",
        "ORDER BY order_date;"
      ]
    },
    {
      "name": "1454a2b7",
      "displayName": "top_categories",
      "queryLines": [
        "SELECT category, revenue\r\n",
        "FROM workspace.gold.agg_category_revenue\r\n",
        "ORDER BY revenue DESC LIMIT 10;"
      ]
    },
    {
      "name": "891c048f",
      "displayName": "revenue_by_state",
      "queryLines": [
        "SELECT c.state, ROUND(SUM(f.price), 2) AS revenue\r\n",
        "FROM workspace.gold.fact_sales f\r\n",
        "JOIN workspace.gold.dim_customer c ON f.customer_key = c.customer_key\r\n",
        "WHERE f.order_found AND f.order_status NOT IN ('canceled', 'unavailable')\r\n",
        "GROUP BY c.state ORDER BY revenue DESC LIMIT 10;"
      ]
    },
    {
      "name": "60a8bf0c",
      "displayName": "payment_mix",
      "queryLines": [
        "SELECT payment_type, COUNT(DISTINCT order_id) AS orders\r\n",
        "FROM workspace.gold.fact_sales\r\n",
        "WHERE order_found\r\n",
        "GROUP BY payment_type ORDER BY orders DESC;"
      ]
    },
    {
      "name": "b384e993",
      "displayName": "customer_type",
      "queryLines": [
        "SELECT CASE WHEN orders > 1 THEN 'Repeat' ELSE 'One-time' END AS customer_type,\r\n",
        "       COUNT(*) AS customers\r\n",
        "FROM workspace.gold.agg_customer_orders\r\n",
        "GROUP BY 1;"
      ]
    },
    {
      "name": "7515252b",
      "displayName": "data_quality_latest",
      "queryLines": [
        "SELECT status, COUNT(*) AS checks\r\n",
        "FROM workspace.ops.dq_log\r\n",
        "WHERE run_id = (SELECT run_id FROM workspace.ops.dq_log ORDER BY checked_at DESC LIMIT 1)\r\n",
        "GROUP BY status;"
      ]
    },
    {
      "name": "f7c669c0",
      "displayName": "Daily Revenue & Orders",
      "queryLines": [
        "SELECT\n",
        "  order_date,\n",
        "  revenue,\n",
        "  orders\n",
        "FROM\n",
        "  workspace.gold.agg_daily_revenue\n",
        "ORDER BY\n",
        "  order_date"
      ]
    }
  ],
